#!/usr/bin/env bash
# Launch the Python GUI from anywhere: ./simavr-gui [-m mcu] [-f hz] [--board file] [firmware.elf|hex]
# Builds libsimavr and sets up .venv on first use.
set -e
root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
py="$root/.venv/bin/python"

ls "$root"/simavr/obj-*/libsimavr.so >/dev/null 2>&1 || make -C "$root/simavr"
if ! "$py" -c "import PySide6, simavr_py" >/dev/null 2>&1; then
    [ -x "$py" ] || uv venv "$root/.venv"
    uv pip install --python "$py" -e "$root/python[gui]"
fi
exec "$py" -m simavr_py.gui "$@"
