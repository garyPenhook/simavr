{
  "name": "ATtiny3217 demo",
  "mmcu": "attiny3217",
  "freq": 3333333,
  "widgets": [
    {"type": "led", "pin": "PA0", "label": "LED0", "color": "red"},
    {"type": "led", "pin": "PA1", "label": "LED1", "color": "green"},
