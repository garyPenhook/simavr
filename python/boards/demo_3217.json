    {"type": "button", "pin": "PB2", "label": "SW0"},
    {"type": "button", "pin": "PB3", "label": "SW1 (latch)", "latch": true},
    {"type": "encoder", "pin_a": "PC0", "pin_b": "PC1", "label": "ENC"},
    {"type": "lcd", "label": "LCD 16x2 (4-bit)", "rs": "PC2", "e": "PC3", "data": ["PB4", "PB5", "PB6", "PB7"], "cols": 16, "rows": 2}
